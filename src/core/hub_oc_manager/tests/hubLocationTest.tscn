[sub_resource type="GDScript" id="GDScript_qy8p7"]
resource_name = "hubLocationTest"
script/source = "extends Node

# A simple test harness.
# The HubLocation must be given a CollisionShape.
# Expects the player to be in collision layer 1
@export var dialogue_system : DialogueSystem
@export var chair_left : HubLocation
@export var chair_right : HubLocation
@export var by_door : HubLocation

var temp_interactions : Dictionary[String, CharacterInteraction] = {
	\"vixStare\" : CharacterInteraction.new( # See CharacterInteraction._init().
		\"vixStare\",
		ResourceLoader.load(\"res://core/hub_oc_manager/temp/vixSpriteFrames.tres\"),
		ResourceLoader.load(\"res://core/hub_oc_manager/temp/dialogues/vixStare.tres\"),
		\"idle\"
		),
	\"vixSleep\" : CharacterInteraction.new( # See CharacterInteraction._init().
		\"vixSleep\",
		ResourceLoader.load(\"res://core/hub_oc_manager/temp/vixSpriteFrames.tres\"),
		ResourceLoader.load(\"res://core/hub_oc_manager/temp/dialogues/vixSleep.tres\"),
		\"sleep\",
		false, false
		),
	\"himekoAboutTheShrine\" : CharacterInteraction.new( # See CharacterInteraction._init().
		\"himekoAboutTheShrine\",
		ResourceLoader.load(\"res://core/hub_oc_manager/temp/himekoSpriteFrames.tres\"),
		ResourceLoader.load(\"res://core/hub_oc_manager/temp/dialogues/himekoAboutTheShrine.tres\"),
		\"idleUp\"
		),
}



func _ready() -> void:
	testTwo()


func testOne() -> void:
	chair_left.setup_location(temp_interactions[\"vixStare\"],dialogue_system)
	chair_right.setup_location(temp_interactions[\"himekoAboutTheShrine\"], dialogue_system)

func testTwo() -> void:
	chair_left.setup_location(temp_interactions[\"vixSleep\"],dialogue_system)
	chair_right.setup_location(temp_interactions[\"himekoAboutTheShrine\"], dialogue_system)
	
"

[sub_resource type="RectangleShape2D" id="RectangleShape2D_fvs06"]
size = Vector2(32, 32)

[sub_resource type="GDScript" id="GDScript_qgwgs"]
script/source = "extends CharacterBody2D

func _physics_process(_delta: float) -> void:
	velocity = Input.get_vector(\"move_left\", \"move_right\",\"move_up\",\"move_down\") * 300
	move_and_slide()
"

