[sub_resource type="GDScript" id="GDScript_712fi"]
resource_name = "interactionManagerTest"
script/source = "extends Node

@onready var hub_interactions_manager: HubInteractionsManager = $\"'hub'/HubInteractionsManager\"
@export var state_to_run_index : int = 0 ## Limited to test_states.size() - 1
@export var test_states : Array[HubState]

func _ready() -> void:
	if state_to_run_index < test_states.size():
		hub_interactions_manager.set_interactions_from_hub_state(
			test_states[state_to_run_index]
		)
"

[sub_resource type="RectangleShape2D" id="RectangleShape2D_qgwgs"]

[sub_resource type="GDScript" id="GDScript_afd3c"]
script/source = "extends CharacterBody2D

func _physics_process(_delta: float) -> void:
	velocity = Input.get_vector(\"move_left\", \"move_right\",\"move_up\",\"move_down\") * 100
	move_and_slide()
"

